# Copy this file to ".env" in the project root before running `docker compose up`.
# docker compose automatically reads a file named ".env" in the same folder
# as docker-compose.yml and substitutes these values into the compose file.

# --- MongoDB ---
# Leave as-is to use the bundled "mongo" container, or point to MongoDB Atlas instead:
# MONGO_URI=mongodb+srv://<user>:<pass>@cluster.mongodb.net/ccpdms?retryWrites=true&w=majority
MONGO_URI=mongodb://mongo:27017/ccpdms

# --- Auth ---
JWT_SECRET=change_this_to_a_long_random_string_min_32_chars
JWT_EXPIRES_IN=7d

# --- Email (used for notifications) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=placement@college.edu
EMAIL_PASS=your_app_specific_password

COLLEGE_EMAIL_DOMAIN=college.edu
MAX_FILE_SIZE_MB=10

# --- AI features (fake job detection / chatbot) ---
GEMINI_API_KEY=your_gemini_api_key
CLAUDE_API_KEY=your_claude_api_key

APP_URL=http://localhost:3000
