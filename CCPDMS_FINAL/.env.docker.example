# Copy this file to CCPDMS_FINAL/.env before running docker compose up
# (MONGO_URI and CLIENT_URL are forced by docker-compose.yml, but keep them
# here too so the file also works if you ever run the backend outside Docker)

PORT=5000
NODE_ENV=production

# Mongo container name from docker-compose.yml
MONGO_URI=mongodb://mongo:27017/joblens

JWT_SECRET=change_this_to_a_random_32+_character_secret
JWT_EXPIRES_IN=7d

CLIENT_URL=http://localhost:3000

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=youremail@gmail.com
EMAIL_PASS=your_gmail_app_password

COLLEGE_EMAIL_DOMAIN=college.edu
MAX_FILE_SIZE_MB=10
UPLOAD_PATH=./uploads

# AI features (all optional - features degrade gracefully without them)
CLAUDE_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GOOGLE_SAFE_BROWSING_API_KEY=
